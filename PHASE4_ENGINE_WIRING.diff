     /// Render one block and hand back the master output.
     pub fn render_block(&mut self) -> &[i32] {
+        // The host's half of the envelope, run every block: the device's app does this from the
+        // plugin's rates, and it is what moves a released voice's phase to zero - the state the
+        // ported `Voice` needs before it will play the note it gated.
+        for track in 0..TRACKS {
+            let [attack, decay, sustain, release] = self.envelopes[track];
+            let start = InstrumentManager::<VoiceEngine>::voice_start_index(track as i32, 0).max(0)
+                as usize;
+            let end = self
+                .mixer
+                .manager
+                .voice_end_index(track as i32, 0)
+                .clamp(0, opz_dsp::manager::VOICES as i32) as usize;
+            for index in start..end {
+                let voice = &mut self.mixer.manager.voices[index];
+                opz_dsp::adsr::update_parameters_adsr(
+                    &mut voice.adsr,
+                    attack,
+                    decay,
+                    sustain,
+                    release,
+                );
+                // The drum engine keeps its own envelope and never advances the *voice's* level, so a
+                // released drum voice would sit in phase 4 forever.
+                if matches!(voice.engine, VoiceEngine::Drum(_)) {
+                    let product = (voice.adsr.level as i64) * (voice.adsr.mul as i64);
